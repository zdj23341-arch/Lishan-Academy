# Copy to an untracked .env. All credentials belong in secret files, not this file.
SECRET_DIRECTORY=/srv/jxsc/secrets
MYSQL_SECRET_DIRECTORY=/srv/jxsc/mysql-secrets
JXSC_PRODUCTION_RECOVERY_ONLY=false
JXSC_WECHAT_APP_ID=
JXSC_WECHAT_MERCHANT_ID=
JXSC_WECHAT_PAY_ENABLED=true
JXSC_WECHAT_PAY_MERCHANT_SERIAL=
JXSC_WECHAT_PAY_PRIVATE_KEY_FILE=/run/secrets/merchant-private.pem
JXSC_WECHAT_PAY_TRUSTED_PUBLIC_KEY_FILES={}
JXSC_WECHAT_PAY_RESPONSE_SIGNING_MODE=PUBLIC_KEY
JXSC_WECHAT_PAY_RESPONSE_KEY_ID=
JXSC_WECHAT_PAY_ENCRYPTION_KEY_ID=
JXSC_WECHAT_PAY_NOTIFY_BASE_URL=
JXSC_WECHAT_PAY_BOOK_JSAPI_APPROVED=false
JXSC_WECHAT_PAY_DIGITAL_PATH=UNCONFIGURED
JXSC_WECHAT_PAY_DIGITAL_APPROVAL_REFERENCE=
JXSC_WECHAT_TRANSFER_ENABLED=false
JXSC_WECHAT_TRANSFER_SCENE_ID=
JXSC_WECHAT_TRANSFER_APPROVAL_REFERENCE=
JXSC_WECHAT_TRANSFER_SCENE_REPORTS=[]
JXSC_WECHAT_TRANSFER_REMARK=Commission remuneration
JXSC_WECHAT_TRANSFER_MAX_FEN=100000
JXSC_WECHAT_STATEMENTS_ENABLED=false
JXSC_STORAGE_COS_ENDPOINT=
JXSC_LOGISTICS_CUSTOMER=
JXSC_CRYPTO_ACTIVE_KEY_ID=
# Replace 0 only with the approved retention policy; 0 blocks closure with financial history.
JXSC_PRIVACY_RETENTION_DAYS=0

# Dedicated disk-backed 8GiB quota directory, owner 10001:10001 mode 0700; see deployment.md.
SCANNER_SPOOL_DIRECTORY=/srv/jxsc/scanner
