{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noImplicitAny": true, "noUncheckedIndexedAccess": true,
    "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "isolatedModules": true, "lib": ["ES2022", "DOM"], "noEmit": true
  }
}
