{
  "name": "jxsc-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "admin",
    "miniprogram"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint shared admin/src miniprogram/src",
    "format:check": "prettier --check shared/src shared/tests admin/src miniprogram/src",
    "dev:admin": "npm run dev -w @jxsc/admin",
    "dev:h5": "npm run dev:h5 -w @jxsc/miniprogram",
    "build:admin": "npm run build -w @jxsc/admin",
    "build:mp:local": "npm run build:mp:local -w @jxsc/miniprogram",
    "review:mp:local": "node tools/open-wechat-review.cjs",
    "build:mp": "npm run build:mp -w @jxsc/miniprogram",
    "build:mp:production": "npm run build:mp:production -w @jxsc/miniprogram",
    "build:h5": "npm run build:h5 -w @jxsc/miniprogram"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@vue/shared": "3.4.21",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.4.2",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "2.1.9",
    "vue-tsc": "2.2.0"
  }
}
